{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NihonCodingg/PROJETO-ASSETS-LOL/schemas/index-manifest.schema.json",
  "title": "Manifesto do índice",
  "description": "Único arquivo com nome fixo em todo o bucket (manifest.json). É o ponto de entrada: diz quais versões existem, qual é a atual, quais fatias de índice cada uma tem e quais zips já estão pré-gerados. Tudo o mais é endereçado por hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "currentVersion", "versions"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "assetsBaseUrl": {
      "description": "Prefixo público do bucket. O front monta URL como `${assetsBaseUrl}/${storageKey}`.",
      "type": "string",
      "format": "uri"
    },
    "currentVersion": {
      "description": "Patch exibido por padrão. É o único com assets copiados (ADR 0007).",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "indexedAt", "assetsCopied", "shards"],
      "properties": {
        "gameVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "indexedAt": { "type": "string", "format": "date-time" },
        "assetsCopied": {
          "description": "true = os bytes estão no bucket. false = só índice; o front usa sourceUrl do ddragon.",
          "type": "boolean"
        },
        "totalAssets": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "shards": {
          "description": "Uma entrada por categoria presente nesta versão.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shard" }
        },
        "zips": {
          "description": "Zips por categoria pré-gerados pelo indexador. Ausentes em versões sem assets copiados.",
          "type": "array",
          "items": { "$ref": "#/$defs/zip" },
          "default": []
        }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "url", "assets", "bytes"],
      "properties": {
        "category": { "type": "string" },
        "url": {
          "description": "Caminho da fatia, com hash no nome para permitir cache imutável.",
          "type": "string"
        },
        "assets": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "zip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "url", "bytes"],
      "properties": {
        "category": { "type": "string" },
        "url": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "assets": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

# ---------------------------------------------------------------------------
# lol-assets — variáveis de ambiente (regra 7 do CLAUDE.md)
# Copie para .env e preencha. .env NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# --- Identificação de rede (regra 4) ---------------------------------------
# Entra no User-Agent de toda requisição do indexador.
INDEXER_CONTACT="seu-email-ou-url-de-contato"
INDEXER_MAX_CONCURRENCY=4
INDEXER_TIMEOUT_SECONDS=30
INDEXER_MAX_RETRIES=5

# --- Fontes ----------------------------------------------------------------
DDRAGON_BASE_URL=https://ddragon.leagueoflegends.com
CDRAGON_BASE_URL=https://raw.communitydragon.org
RIOT_STATIC_BASE_URL=https://static.developer.riotgames.com

# --- Wiki (regra 3): só pode virar "true" com consentimento documentado -----
WIKI_CONSENT_GRANTED=false
WIKI_BASE_URL=https://wiki.leagueoflegends.com
WIKI_MAX_CONCURRENCY=1

# --- Storage: INATIVO desde o ADR 0012 --------------------------------------
# O projeto opera SEM storage: o índice aponta para as URLs das fontes. Estas
# variáveis ficam documentadas porque são o caminho de volta para a opção A —
# ver a §"Como voltar para A" em docs/adr/0012-onde-guardar-os-assets.md.
# Deixe vazias para operar no modo atual.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=lol-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Base pública do bucket. Vazia = os assets vêm da sourceUrl de cada registro.
ASSETS_PUBLIC_BASE_URL=

# --- API: OPCIONAL (ADR 0006) ----------------------------------------------
# O site funciona inteiro sem a API. Preencha só se for rodá-la localmente.
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_ZIP_MAX_ITEMS=500

# --- Web (expostas ao navegador) -------------------------------------------
# De onde o front carrega manifesto, catálogo e fatias. Com o índice servido pelo
# próprio app (ADR 0012), o padrão é um caminho relativo.
NEXT_PUBLIC_ASSETS_BASE_URL=/indice
